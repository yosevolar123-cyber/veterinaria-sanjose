@if (Visible)
{
    <div class="fixed inset-0 z-50 flex items-start justify-center overflow-y-auto bg-slate-900/40 px-4 py-6 sm:items-center" @onclick="Cerrar">
        <div class="tarjeta my-auto max-h-[calc(100dvh-3rem)] w-full @AnchoClase overflow-y-auto p-6" @onclick:stopPropagation="true">
            <div class="modal-cabecera">
                <h2 class="truncate text-lg sm:text-xl">@Titulo</h2>
                <button class="btn-cerrar" aria-label="Cerrar" @onclick="Cerrar">✕</button>
            </div>
            @ChildContent
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string Titulo { get; set; } = "";
    [Parameter] public string AnchoClase { get; set; } = "max-w-md";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Task Cerrar() => VisibleChanged.InvokeAsync(false);
}
