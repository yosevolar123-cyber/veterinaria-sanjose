@using System.ComponentModel.DataAnnotations
@using VetSanJose.Shared.Auth
@inject AuthApiClient AuthApiClient
@inject TokenStorage TokenStorage
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

@if (Visible)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 px-4 fade-in-up" @onclick="Cerrar">
        <div class="tarjeta w-full max-w-md p-6" @onclick:stopPropagation="true">
            <div class="mb-4 flex items-center justify-between">
                <h2 class="text-xl">¡Bienvenido de vuelta! 🐾</h2>
                <button class="text-gray-400 hover:text-gray-600" @onclick="Cerrar">✕</button>
            </div>

            <div class="mb-4 flex gap-2 rounded-full bg-[var(--color-celeste-suave)] p-1">
                <button class="flex-1 rounded-full py-2 text-sm font-semibold transition-colors @(tab == Tab.Login ? "bg-white shadow text-[var(--color-celeste-intenso)]" : "text-gray-500")"
                        @onclick="() => tab = Tab.Login">
                    Iniciar sesión
                </button>
                <button class="flex-1 rounded-full py-2 text-sm font-semibold transition-colors @(tab == Tab.Registro ? "bg-white shadow text-[var(--color-celeste-intenso)]" : "text-gray-500")"
                        @onclick="() => tab = Tab.Registro">
                    Registrarme
                </button>
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <p class="mb-3 rounded-lg bg-red-50 px-3 py-2 text-sm text-[var(--color-error)]">@error</p>
            }

            @if (tab == Tab.Login)
            {
                <EditForm Model="loginModel" OnValidSubmit="EnviarLoginAsync">
                    <DataAnnotationsValidator />
                    <div class="space-y-3">
                        <div>
                            <input type="email" class="w-full rounded-xl border border-[var(--color-gris-borde)] px-4 py-2.5 focus:border-[var(--color-celeste)] focus:outline-none"
                                   placeholder="Correo electrónico" @bind="loginModel.Email" />
                            <ValidationMessage For="() => loginModel.Email" class="text-xs text-[var(--color-error)]" />
                        </div>
                        <div>
                            <input type="password" class="w-full rounded-xl border border-[var(--color-gris-borde)] px-4 py-2.5 focus:border-[var(--color-celeste)] focus:outline-none"
                                   placeholder="Contraseña" @bind="loginModel.Password" />
                            <ValidationMessage For="() => loginModel.Password" class="text-xs text-[var(--color-error)]" />
                        </div>
                        <button type="submit" class="btn-primario w-full" disabled="@cargando">
                            @(cargando ? "Ingresando..." : "Iniciar sesión")
                        </button>
                    </div>
                </EditForm>
            }
            else
            {
                <EditForm Model="registroModel" OnValidSubmit="EnviarRegistroAsync">
                    <DataAnnotationsValidator />
                    <div class="space-y-3">
                        <div class="grid grid-cols-2 gap-3">
                            <input class="rounded-xl border border-[var(--color-gris-borde)] px-4 py-2.5 focus:border-[var(--color-celeste)] focus:outline-none"
                                   placeholder="Nombre" @bind="registroModel.Nombre" />
                            <input class="rounded-xl border border-[var(--color-gris-borde)] px-4 py-2.5 focus:border-[var(--color-celeste)] focus:outline-none"
                                   placeholder="Apellido" @bind="registroModel.Apellido" />
                        </div>
                        <input type="email" class="w-full rounded-xl border border-[var(--color-gris-borde)] px-4 py-2.5 focus:border-[var(--color-celeste)] focus:outline-none"
                               placeholder="Correo electrónico" @bind="registroModel.Email" />
                        <input type="password" class="w-full rounded-xl border border-[var(--color-gris-borde)] px-4 py-2.5 focus:border-[var(--color-celeste)] focus:outline-none"
                               placeholder="Contraseña (mín. 8 caracteres)" @bind="registroModel.Password" />
                        <input class="w-full rounded-xl border border-[var(--color-gris-borde)] px-4 py-2.5 focus:border-[var(--color-celeste)] focus:outline-none"
                               placeholder="Teléfono (opcional)" @bind="registroModel.Telefono" />
                        <DataAnnotationsValidator />
                        <button type="submit" class="btn-primario w-full" disabled="@cargando">
                            @(cargando ? "Creando cuenta..." : "Registrarme")
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
}

@code {
    private enum Tab { Login, Registro }

    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    private Tab tab = Tab.Login;
    private bool cargando;
    private string? error;

    private readonly LoginFormModel loginModel = new();
    private readonly RegistroFormModel registroModel = new();

    private async Task Cerrar()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }

    private async Task EnviarLoginAsync()
    {
        cargando = true;
        error = null;
        try
        {
            var resultado = await AuthApiClient.LoginAsync(new LoginRequest(loginModel.Email, loginModel.Password));
            await CompletarSesionAsync(resultado);
        }
        catch (HttpRequestException)
        {
            error = "Correo o contraseña incorrectos.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task EnviarRegistroAsync()
    {
        cargando = true;
        error = null;
        try
        {
            var resultado = await AuthApiClient.RegistrarClienteAsync(new RegistroClienteRequest(
                registroModel.Nombre, registroModel.Apellido, registroModel.Email, registroModel.Password, registroModel.Telefono));
            await CompletarSesionAsync(resultado);
        }
        catch (HttpRequestException)
        {
            error = "No se pudo completar el registro. Verifica los datos o si el correo ya está en uso.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CompletarSesionAsync(AuthResponse? resultado)
    {
        if (resultado is null)
        {
            error = "No se pudo iniciar sesión.";
            return;
        }

        await TokenStorage.GuardarAsync(resultado.AccessToken, resultado.RefreshToken);
        AuthStateProvider.NotificarSesionIniciada(resultado.AccessToken);
        await Cerrar();
        Navigation.NavigateTo(RolARuta(resultado.Usuario.Rol));
    }

    private static string RolARuta(string rol) => rol switch
    {
        Roles.Doctor => "/panel-doctor",
        Roles.Secretaria => "/panel-secretaria",
        Roles.Administrador => "/panel-admin",
        _ => "/mi-cuenta",
    };

    private class LoginFormModel
    {
        [Required(ErrorMessage = "Ingresa tu correo")]
        [EmailAddress(ErrorMessage = "Correo inválido")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Ingresa tu contraseña")]
        public string Password { get; set; } = "";
    }

    private class RegistroFormModel
    {
        [Required] public string Nombre { get; set; } = "";
        [Required] public string Apellido { get; set; } = "";

        [Required(ErrorMessage = "Ingresa tu correo")]
        [EmailAddress(ErrorMessage = "Correo inválido")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Ingresa una contraseña")]
        [MinLength(8, ErrorMessage = "Mínimo 8 caracteres")]
        public string Password { get; set; } = "";

        public string? Telefono { get; set; }
    }
}
