@using VetSanJose.Shared.Citas
@using VetSanJose.Shared.Mascotas
@using VetSanJose.Shared.Usuarios
@inject UsuariosApiClient UsuariosApiClient
@inject MascotasApiClient MascotasApiClient
@inject CitasApiClient CitasApiClient

@if (Visible)
{
    <div class="fixed inset-0 z-50 flex items-start justify-center overflow-y-auto bg-slate-900/40 px-4 py-6 sm:items-center" @onclick="Cerrar">
        <div class="tarjeta my-auto max-h-[calc(100dvh-3rem)] w-full max-w-md overflow-y-auto p-6" @onclick:stopPropagation="true">
            <div class="modal-cabecera">
                <h2 class="text-lg sm:text-xl">Nueva cita 📅</h2>
                <button class="btn-cerrar" aria-label="Cerrar" @onclick="Cerrar">✕</button>
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <p class="mb-3 rounded-lg bg-red-50 px-3 py-2 text-sm text-[var(--color-error)]">@error</p>
            }

            <div class="space-y-3">
                <div>
                    <label class="mb-1 block text-xs text-gray-500">Cliente</label>
                    <select class="w-full campo-brutal" @bind="clienteSeleccionado" @bind:after="CargarMascotasAsync">
                        <option value="0">Selecciona un cliente</option>
                        @foreach (var cliente in clientes)
                        {
                            <option value="@cliente.Id">@cliente.Nombre @cliente.Apellido</option>
                        }
                    </select>
                </div>

                @if (clienteSeleccionado > 0)
                {
                    <div>
                        <label class="mb-1 block text-xs text-gray-500">Mascota</label>
                        <select class="w-full campo-brutal" @bind="mascotaSeleccionada">
                            <option value="0">Selecciona una mascota</option>
                            @foreach (var mascota in mascotas)
                            {
                                <option value="@mascota.Id">@mascota.Nombre (@mascota.Especie)</option>
                            }
                        </select>
                    </div>
                }

                @if (MostrarSelectorDoctor)
                {
                    <div>
                        <label class="mb-1 block text-xs text-gray-500">Doctor</label>
                        <select class="w-full campo-brutal" @bind="doctorSeleccionado">
                            <option value="0">Selecciona un doctor</option>
                            @foreach (var doctor in doctores)
                            {
                                <option value="@doctor.Id">@doctor.Nombre @doctor.Apellido</option>
                            }
                        </select>
                    </div>
                }

                <div>
                    <label class="mb-1 block text-xs text-gray-500">Fecha y hora</label>
                    <input type="datetime-local" class="w-full campo-brutal" @bind="fechaHora" />
                </div>

                <div>
                    <label class="mb-1 block text-xs text-gray-500">Motivo</label>
                    <input class="w-full campo-brutal" placeholder="Motivo de la consulta" @bind="motivo" />
                </div>

                <button class="btn-primario w-full" disabled="@guardando" @onclick="GuardarAsync">
                    @(guardando ? "Guardando..." : "Agendar cita")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public bool MostrarSelectorDoctor { get; set; }
    [Parameter] public long? DoctorFijoId { get; set; }
    [Parameter] public EventCallback OnCitaCreada { get; set; }

    private List<UsuarioAdminDto> clientes = [];
    private List<UsuarioAdminDto> doctores = [];
    private List<MascotaDto> mascotas = [];

    private long clienteSeleccionado;
    private long mascotaSeleccionada;
    private long doctorSeleccionado;
    private DateTime fechaHora = DateTime.Now.AddHours(1);
    private string motivo = "";
    private bool guardando;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && clientes.Count == 0)
        {
            try
            {
                clientes = await UsuariosApiClient.GetAllAsync("cliente", soloActivos: true);
                if (MostrarSelectorDoctor)
                {
                    doctores = await UsuariosApiClient.GetAllAsync("doctor", soloActivos: true);
                }
            }
            catch (HttpRequestException ex)
            {
                error = $"No se pudo cargar clientes/doctores: {ex.Message}";
            }
        }
    }

    private async Task CargarMascotasAsync()
    {
        mascotaSeleccionada = 0;
        error = null;
        try
        {
            mascotas = clienteSeleccionado > 0 ? await MascotasApiClient.GetPorClienteAsync(clienteSeleccionado) : [];
        }
        catch (HttpRequestException ex)
        {
            mascotas = [];
            error = $"No se pudo cargar las mascotas del cliente: {ex.Message}";
        }
    }

    private async Task Cerrar()
    {
        Visible = false;
        error = null;
        await VisibleChanged.InvokeAsync(false);
    }

    private async Task GuardarAsync()
    {
        error = null;

        if (mascotaSeleccionada == 0)
        {
            error = "Selecciona una mascota.";
            return;
        }

        var doctorId = MostrarSelectorDoctor ? doctorSeleccionado : DoctorFijoId;
        if (MostrarSelectorDoctor && doctorSeleccionado == 0)
        {
            error = "Selecciona un doctor.";
            return;
        }

        guardando = true;
        try
        {
            await CitasApiClient.CrearAsync(new CrearCitaRequest(
                mascotaSeleccionada, doctorId, new DateTimeOffset(fechaHora), motivo));

            await OnCitaCreada.InvokeAsync();
            await Cerrar();
        }
        catch (HttpRequestException)
        {
            error = "No se pudo agendar la cita. Verifica los datos.";
        }
        finally
        {
            guardando = false;
        }
    }
}
