@page "/panel-secretaria"
@attribute [Authorize(Roles = Roles.Secretaria)]
@using VetSanJose.Shared.Usuarios
@using VetSanJose.Shared.Mascotas
@using System.Text.RegularExpressions
@using VetSanJose.Client.Pages.Admin
@inject UsuariosApiClient UsuariosApiClient
@inject DashboardApiClient DashboardApiClient

<PageTitle>Panel Secretaría — Veterinaria San José</PageTitle>

<div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <h1 class="mb-8 text-3xl">Panel de secretaría 🗓️</h1>

    @if (resumen is not null)
    {
        <div class="mb-10 grid gap-4 sm:grid-cols-2">
            <div data-aos="fade-up">
                <StatCard Icono="📅" Valor="@resumen.CitasHoy.ToString()" Etiqueta="Citas hoy" />
            </div>
            <div data-aos="fade-up" data-aos-delay="80">
                <StatCard Icono="⏳" Valor="@resumen.CitasPendientes.ToString()" Etiqueta="Citas pendientes"
                          FondoIcono="bg-amber-50" ColorValor="text-[var(--color-advertencia)]" />
            </div>
        </div>
    }

    <div class="carril-scroll mb-8 gap-2 rounded-full bg-[var(--color-celeste-suave)] p-1 sm:w-fit sm:flex-wrap sm:overflow-x-visible">
        @foreach (var t in new[] { Tab.Agenda, Tab.Clientes, Tab.Stock })
        {
            <button class="min-h-11 rounded-full px-4 py-2 text-sm font-semibold transition-colors @(tab == t ? "bg-white shadow text-[var(--color-celeste-intenso)]" : "text-gray-500")"
                    @onclick="() => tab = t">
                @TituloTab(t)
            </button>
        }
    </div>

    <div class="route-fade" @key="tab">
    @if (tab == Tab.Agenda)
    {
        <AgendaView MostrarFiltroDoctor="true" PermitirCrear="true" PermitirGestionar="true" />
    }
    else if (tab == Tab.Clientes)
    {
        @if (!string.IsNullOrEmpty(error))
        {
            <p class="mb-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-[var(--color-error)]">@error</p>
        }

        <h3 class="mb-3 text-lg">Doctores</h3>
        @if (doctores.Count == 0)
        {
            <p class="mb-6 text-sm text-gray-400">No hay doctores registrados aún.</p>
        }
        else
        {
            <div class="mb-8 grid gap-3 sm:grid-cols-2">
                @foreach (var (doctor, indice) in doctores.Select((d, i) => (d, i)))
                {
                    <div class="tarjeta p-4" data-aos="fade-up" data-aos-delay="@(indice * 80)">
                        <p class="font-semibold">🩺 @doctor.Nombre @doctor.Apellido</p>
                        <p class="text-sm text-gray-400">
                            @(doctor.Especialidad ?? "Sin especialidad registrada")
                            @(string.IsNullOrWhiteSpace(doctor.Matricula) ? "" : $"· Mat. {doctor.Matricula}")
                        </p>
                    </div>
                }
            </div>
        }

        <div class="mb-3 flex items-center justify-between">
            <h3 class="text-lg">Clientes y mascotas</h3>
            <button class="btn-primario" @onclick="AbrirNuevoCliente">+ Nuevo cliente</button>
        </div>
        @if (clientes.Count == 0)
        {
            <p class="py-8 text-center text-gray-400">No hay clientes registrados aún.</p>
        }
        else
        {
            <div class="space-y-3">
                @foreach (var cliente in clientes)
                {
                    <div class="tarjeta p-4">
                        <button class="flex w-full items-center justify-between text-left" @onclick="() => ToggleCliente(cliente.Id)">
                            <div>
                                <p class="font-semibold">@cliente.Nombre @cliente.Apellido</p>
                                <p class="text-sm text-gray-400">@cliente.Email @(string.IsNullOrWhiteSpace(cliente.Telefono) ? "" : $"· {cliente.Telefono}")</p>
                            </div>
                            <span class="text-gray-400">@(clienteExpandido == cliente.Id ? "▲" : "▼")</span>
                        </button>

                        @if (clienteExpandido == cliente.Id)
                        {
                            <div class="mt-3 border-t border-[var(--color-gris-borde)] pt-3">
                                <GestionMascotas ClienteId="cliente.Id" />
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
    else if (tab == Tab.Stock)
    {
        <AdminProductos />
    }
    </div>
</div>

<ModalShell @bind-Visible="modalClienteVisible" Titulo="Nueva cuenta de cliente">
    @if (!string.IsNullOrEmpty(errorCliente))
    {
        <p class="mb-3 rounded-lg bg-red-50 px-3 py-2 text-sm text-[var(--color-error)]">@errorCliente</p>
    }

    <div class="space-y-3">
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <input class="campo-brutal" placeholder="Nombre" @bind="formCliente.Nombre" @bind:event="oninput"
                   pattern="[A-Za-zÁÉÍÓÚÑÜáéíóúñü\s'-]+" title="Solo letras" />
            <input class="campo-brutal" placeholder="Apellido" @bind="formCliente.Apellido" @bind:event="oninput"
                   pattern="[A-Za-zÁÉÍÓÚÑÜáéíóúñü\s'-]+" title="Solo letras" />
        </div>
        <input type="email" class="w-full campo-brutal" placeholder="Correo" @bind="formCliente.Email" />
        <input type="password" class="w-full campo-brutal" placeholder="Contraseña temporal (mín. 8 caracteres)" @bind="formCliente.Password" />
        <input type="tel" class="w-full campo-brutal" placeholder="Teléfono (opcional)" @bind="formCliente.Telefono" @bind:event="oninput"
               pattern="\+?[0-9]{7,15}" title="Solo números (7 a 15 dígitos), '+' opcional al inicio" />

        <button class="btn-primario w-full" disabled="@guardandoCliente" @onclick="GuardarClienteAsync">
            @(guardandoCliente ? "Creando..." : "Crear cuenta de cliente")
        </button>
    </div>
</ModalShell>

@code {
    private enum Tab { Agenda, Clientes, Stock }

    private Tab tab = Tab.Agenda;
    private VetSanJose.Shared.Dashboard.SecretariaDashboardDto? resumen;

    private List<UsuarioAdminDto> clientes = [];
    private List<UsuarioAdminDto> doctores = [];
    private long? clienteExpandido;
    private string? error;

    private bool modalClienteVisible;
    private bool guardandoCliente;
    private string? errorCliente;
    private NuevoClienteModel formCliente = new();

    private static readonly Regex NombreRegex = new(@"^[A-Za-zÁÉÍÓÚÑÜáéíóúñü\s'-]+$", RegexOptions.Compiled);
    private static readonly Regex TelefonoRegex = new(@"^\+?[0-9]{7,15}$", RegexOptions.Compiled);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            resumen = await DashboardApiClient.GetSecretariaAsync();
        }
        catch (HttpRequestException) { }

        try
        {
            clientes = await UsuariosApiClient.GetAllAsync("cliente", soloActivos: true);
            doctores = await UsuariosApiClient.GetAllAsync("doctor", soloActivos: true);
        }
        catch (HttpRequestException ex)
        {
            error = $"No se pudo cargar clientes/doctores: {ex.Message}";
        }
    }

    private void ToggleCliente(long clienteId) =>
        clienteExpandido = clienteExpandido == clienteId ? null : clienteId;

    private void AbrirNuevoCliente()
    {
        formCliente = new NuevoClienteModel();
        errorCliente = null;
        modalClienteVisible = true;
    }

    private async Task GuardarClienteAsync()
    {
        errorCliente = null;

        if (!NombreRegex.IsMatch(formCliente.Nombre.Trim()))
        {
            errorCliente = "El nombre solo puede contener letras.";
            return;
        }

        if (!NombreRegex.IsMatch(formCliente.Apellido.Trim()))
        {
            errorCliente = "El apellido solo puede contener letras.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(formCliente.Telefono) && !TelefonoRegex.IsMatch(formCliente.Telefono.Trim()))
        {
            errorCliente = "El teléfono solo puede contener números (7 a 15 dígitos), con un '+' opcional al inicio.";
            return;
        }

        guardandoCliente = true;
        try
        {
            var response = await UsuariosApiClient.CrearAsync(new CrearUsuarioRequest(
                formCliente.Nombre, formCliente.Apellido, formCliente.Email, formCliente.Password,
                Roles.Cliente, formCliente.Telefono));

            if (!response.IsSuccessStatusCode)
            {
                errorCliente = await response.LeerMensajeAsync();
                return;
            }

            modalClienteVisible = false;
            clientes = await UsuariosApiClient.GetAllAsync("cliente", soloActivos: true);
        }
        catch (HttpRequestException ex)
        {
            errorCliente = $"No se pudo crear la cuenta: {ex.Message}";
        }
        finally
        {
            guardandoCliente = false;
        }
    }

    private class NuevoClienteModel
    {
        public string Nombre { get; set; } = "";
        public string Apellido { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string? Telefono { get; set; }
    }

    private static string TituloTab(Tab t) => t switch
    {
        Tab.Agenda => "Agenda",
        Tab.Clientes => "Clientes y mascotas",
        Tab.Stock => "Stock y precios",
        _ => "",
    };
}
