@page "/mi-cuenta/mascotas/{Id:long}"
@attribute [Authorize(Roles = Roles.Cliente)]
@using VetSanJose.Shared.Mascotas
@using VetSanJose.Shared.HistorialesMedicos
@inject MascotasApiClient MascotasApiClient
@inject HistorialMedicoApiClient HistorialApiClient
@inject ArchivosApiClient ArchivosApiClient

<PageTitle>Mascota — Veterinaria San José</PageTitle>

<div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <a href="mi-cuenta/mascotas" class="mb-4 inline-block text-sm text-[var(--color-celeste-intenso)] hover:underline">← Mis mascotas</a>

    @if (cargando)
    {
        <div class="skeleton h-32"></div>
    }
    else if (mascota is null)
    {
        <p class="py-10 text-center text-gray-400">No se encontró esta mascota 🐾</p>
    }
    else
    {
        <div class="tarjeta mb-8 flex items-center gap-4 p-6">
            @if (!string.IsNullOrWhiteSpace(fotoPreviewUrl))
            {
                <img src="@fotoPreviewUrl" class="h-16 w-16 rounded-full border-2 border-dashed border-[var(--color-celeste-intenso)] object-cover" alt="Vista previa de la foto" />
            }
            else if (!string.IsNullOrWhiteSpace(mascota.FotoUrl))
            {
                <img src="@mascota.FotoUrl" class="h-16 w-16 rounded-full object-cover" alt="Foto de @mascota.Nombre" />
            }
            else
            {
                <span class="text-5xl">@(mascota.Especie.Equals("gato", StringComparison.OrdinalIgnoreCase) ? "🐱" : "🐶")</span>
            }
            <div class="flex-1">
                <h1 class="text-2xl">@mascota.Nombre</h1>
                <p class="text-gray-500">@mascota.Especie @(string.IsNullOrWhiteSpace(mascota.Raza) ? "" : $"· {mascota.Raza}")</p>
                @if (mascota.Peso is not null)
                {
                    <p class="text-sm text-gray-400">Peso: @mascota.Peso kg</p>
                }
                <div class="mt-2">
                    <label class="cursor-pointer text-xs text-[var(--color-celeste-intenso)] hover:underline">
                        @(subiendoFoto ? "Subiendo foto..." : "Cambiar foto")
                        <InputFile OnChange="SubirFotoAsync" accept="image/*" class="hidden" disabled="@subiendoFoto" />
                    </label>
                    <p class="text-xs text-gray-400">JPEG/PNG/WEBP/GIF, máx. 10 MB. Se recorta en círculo.</p>
                    @if (!string.IsNullOrEmpty(errorFoto))
                    {
                        <p class="text-xs text-[var(--color-error)]">@errorFoto</p>
                    }
                </div>
            </div>
        </div>

        <h2 class="mb-4 text-xl">Historial médico</h2>

        @if (historial.Count == 0)
        {
            <p class="py-8 text-center text-gray-400">Aún no hay historial médico registrado 🐾</p>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var registro in historial)
                {
                    <div class="tarjeta p-5">
                        <div class="mb-2 flex items-center justify-between text-sm text-gray-400">
                            <span>🩺 @registro.DoctorNombre</span>
                            <span>@registro.Fecha.LocalDateTime.ToString("dd/MM/yyyy")</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(registro.Diagnostico))
                        {
                            <p><span class="font-semibold">Diagnóstico:</span> @registro.Diagnostico</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(registro.Tratamiento))
                        {
                            <p><span class="font-semibold">Tratamiento:</span> @registro.Tratamiento</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(registro.Observaciones))
                        {
                            <p><span class="font-semibold">Observaciones:</span> @registro.Observaciones</p>
                        }
                        @if (registro.Insumos.Count > 0)
                        {
                            <p class="mt-2 text-sm text-gray-400">
                                Insumos: @string.Join(", ", registro.Insumos.Select(i => $"{i.ProductoNombre} x{i.Cantidad}"))
                            </p>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public long Id { get; set; }

    private MascotaDto? mascota;
    private List<HistorialMedicoDto> historial = [];
    private bool cargando = true;

    private bool subiendoFoto;
    private string? errorFoto;
    private string? fotoPreviewUrl;

    private const long TamanoMaximoFotoBytes = 10 * 1024 * 1024;
    private static readonly HashSet<string> ContentTypesPermitidos = new(StringComparer.OrdinalIgnoreCase)
    {
        "image/jpeg", "image/jpg", "image/png", "image/webp", "image/gif",
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            mascota = await MascotasApiClient.GetByIdAsync(Id);
            historial = await HistorialApiClient.GetPorMascotaAsync(Id);
        }
        catch (HttpRequestException)
        {
            mascota = null;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task SubirFotoAsync(InputFileChangeEventArgs e)
    {
        if (mascota is null) return;

        errorFoto = null;
        fotoPreviewUrl = null;
        var archivo = e.File;

        if (!ContentTypesPermitidos.Contains(archivo.ContentType))
        {
            errorFoto = "Formato no soportado. Usa una imagen JPEG, PNG, WEBP o GIF.";
            return;
        }

        if (archivo.Size > TamanoMaximoFotoBytes)
        {
            errorFoto = "El archivo supera el tamaño máximo permitido (10 MB).";
            return;
        }

        subiendoFoto = true;
        try
        {
            using var ms = new MemoryStream();
            await archivo.OpenReadStream(TamanoMaximoFotoBytes).CopyToAsync(ms);
            fotoPreviewUrl = $"data:{archivo.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
            ms.Position = 0;

            var (exito, url, error) = await ArchivosApiClient.SubirImagenAsync("mascotas", ms, archivo.Name, archivo.ContentType);
            if (!exito)
            {
                errorFoto = error;
                return;
            }

            var actualizada = await MascotasApiClient.ActualizarAsync(mascota.Id, new ActualizarMascotaRequest(
                mascota.Nombre, mascota.Especie, mascota.Raza, mascota.FechaNacimiento, mascota.Sexo, mascota.Peso, mascota.Activo, url));

            if (actualizada is not null)
            {
                mascota = actualizada;
            }
        }
        finally
        {
            subiendoFoto = false;
        }
    }
}
