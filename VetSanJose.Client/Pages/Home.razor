        new("Tienda", "Alimentos, medicamentos y accesorios para tu mascota.",
            "https://images.unsplash.com/photo-1714068691210-073dc52c6c1d?auto=format&fit=crop&w=800&q=75"),
    ];

    private readonly List<Testimonio> testimonios =
    [
        new("Camila R.", "Toby", "El equipo fue increíblemente atento con Toby, se nota que aman lo que hacen.",
            "https://images.unsplash.com/photo-1562337404-3044c84ac061?auto=format&fit=crop&w=200&q=75"),
