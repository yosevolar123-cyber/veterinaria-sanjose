        new("Seguimiento post-consulta",
            "Te acompañamos después de cada visita para asegurarnos de que la recuperación va por buen camino.",
            "https://images.unsplash.com/photo-1557495235-340eb888a9fb?auto=format&fit=crop&w=900&q=75"),
    ];

    private readonly List<Servicio> servicios =
    [
        new("Consultas médicas", "Diagnóstico y tratamiento por veterinarios especializados.",
            "https://images.unsplash.com/photo-1770836037816-4445dbd449fd?auto=format&fit=crop&w=800&q=75"),
        new("Vacunación", "Esquemas de vacunación completos para perros y gatos.",
