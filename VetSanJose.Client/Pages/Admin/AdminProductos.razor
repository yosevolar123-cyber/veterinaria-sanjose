@using VetSanJose.Shared.Productos
@using VetSanJose.Shared.Categorias
@using VetSanJose.Shared.Proveedores
@inject ProductosApiClient ProductosApiClient
@inject CategoriasApiClient CategoriasApiClient
@inject ProveedoresApiClient ProveedoresApiClient
@inject ArchivosApiClient ArchivosApiClient

<div>
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <h3 class="text-lg">Productos</h3>
        <button class="btn-primario" @onclick="AbrirCrear">+ Nuevo producto</button>
    </div>

    @if (cargando)
    {
        <div class="skeleton h-40"></div>
    }
    else
    {
        <div class="tabla-scroll">
            <table class="w-full min-w-[46rem] text-left text-sm">
                <thead>
                    <tr class="border-b border-[var(--color-gris-borde)] text-gray-500">
                        <th class="py-2">Producto</th>
                        <th class="py-2">Tipo</th>
                        <th class="py-2">Categoría</th>
                        <th class="py-2">Precio</th>
                        <th class="py-2">Stock</th>
                        <th class="py-2">Estado</th>
                        <th class="py-2"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var producto in productos)
                    {
                        <tr class="border-b border-[var(--color-gris-borde)]">
                            <td class="py-2">@producto.Nombre</td>
                            <td class="py-2">
                                <span class="rounded-full px-2 py-0.5 text-xs @(producto.Tipo == "insumo_interno" ? "bg-amber-50 text-amber-700" : "bg-[var(--color-celeste-suave)] text-[var(--color-celeste-intenso)]")">
                                    @(producto.Tipo == "insumo_interno" ? "Insumo interno" : "Venta pública")
                                </span>
                            </td>
                            <td class="py-2">@(producto.CategoriaNombre ?? "—")</td>
                            <td class="py-2">Bs @producto.Precio.ToString("N2")</td>
                            <td class="py-2">
                                <div class="flex items-center gap-1">
                                    <span>@producto.Stock</span>
                                    <button class="inline-flex min-h-11 w-8 items-center justify-center text-sm text-[var(--color-celeste-intenso)]" title="Ajustar stock" aria-label="Ajustar stock" @onclick="() => AbrirAjusteStock(producto)">✎</button>
                                </div>
                            </td>
                            <td class="py-2">
                                <span class="rounded-full px-2 py-0.5 text-xs @(producto.Activo ? "bg-green-50 text-[var(--color-exito)]" : "bg-red-50 text-[var(--color-error)]")">
                                    @(producto.Activo ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td class="py-2 text-right">
                                <button class="inline-flex min-h-11 items-center text-[var(--color-celeste-intenso)] hover:underline" @onclick="() => AbrirEditar(producto)">Editar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<ModalShell @bind-Visible="modalVisible" Titulo="@(editandoId is null ? "Nuevo producto" : "Editar producto")">
    @if (!string.IsNullOrEmpty(error))
    {
        <p class="mb-3 rounded-lg bg-red-50 px-3 py-2 text-sm text-[var(--color-error)]">@error</p>
    }
    <div class="space-y-3">
        <input class="w-full campo-brutal" placeholder="Nombre" @bind="form.Nombre" />
        <textarea class="w-full campo-brutal" rows="2" placeholder="Descripción" @bind="form.Descripcion"></textarea>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <select class="campo-brutal" @bind="form.CategoriaId">
                <option value="0">Sin categoría</option>
                @foreach (var categoria in categorias)
                {
                    <option value="@categoria.Id">@categoria.Nombre</option>
                }
            </select>
            <select class="campo-brutal" @bind="form.ProveedorId">
                <option value="0">Sin proveedor</option>
                @foreach (var proveedor in proveedores)
                {
                    <option value="@proveedor.Id">@proveedor.Nombre</option>
                }
            </select>
        </div>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <input type="number" step="0.01" min="0" class="campo-brutal" placeholder="Precio (Bs)" @bind="form.Precio" />
            @if (editandoId is null)
            {
                <input type="number" min="0" class="campo-brutal" placeholder="Stock inicial" @bind="form.Stock" />
            }
        </div>

        <div>
            <label class="mb-1 block text-xs text-gray-500">Tipo de producto</label>
            <select class="w-full campo-brutal" @bind="form.Tipo">
                <option value="venta_publico">Venta al público (visible en la tienda)</option>
                <option value="insumo_interno">Insumo interno (solo uso del doctor)</option>
            </select>
        </div>

        <div>
            <label class="mb-1 block text-xs text-gray-500">Imagen del producto (JPEG, PNG, WEBP o GIF, máx. 10 MB)</label>
            <div class="flex items-center gap-3">
                @if (!string.IsNullOrWhiteSpace(imagenPreviewUrl))
                {
                    <img src="@imagenPreviewUrl" class="h-24 w-24 shrink-0 rounded-xl border-2 border-dashed border-[var(--color-celeste-intenso)] object-cover" alt="Vista previa" />
                }
                else if (!string.IsNullOrWhiteSpace(form.ImagenUrl))
                {
                    <img src="@form.ImagenUrl" class="h-24 w-24 shrink-0 rounded-xl object-cover" alt="Vista previa" />
                }
                <div class="flex-1">
                    <InputFile OnChange="SubirImagenAsync" accept="image/*" disabled="@subiendoImagen" />
                    @if (!string.IsNullOrWhiteSpace(imagenPreviewUrl))
                    {
                        <p class="mt-1 text-xs text-gray-400">Así se verá en la tienda.</p>
                    }
                    @if (subiendoImagen)
                    {
                        <p class="mt-1 text-xs text-gray-400">Subiendo imagen...</p>
                    }
                    @if (!string.IsNullOrEmpty(errorImagen))
                    {
                        <p class="mt-1 text-xs text-[var(--color-error)]">@errorImagen</p>
                    }
                </div>
            </div>
        </div>

        @if (editandoId is not null)
        {
            <label class="flex items-center gap-2 text-sm">
                <input type="checkbox" @bind="form.Activo" /> Producto activo
            </label>
        }

        <button class="btn-primario w-full" disabled="@(guardando || subiendoImagen)" @onclick="GuardarAsync">
            @(guardando ? "Guardando..." : subiendoImagen ? "Esperando imagen..." : "Guardar")
        </button>
    </div>
</ModalShell>

<ModalShell @bind-Visible="modalStockVisible" Titulo="Ajustar stock">
    @if (productoAjuste is not null)
    {
        <p class="mb-3 text-sm text-gray-500">Stock actual de <strong>@productoAjuste.Nombre</strong>: @productoAjuste.Stock</p>
        <input type="number" class="w-full campo-brutal" placeholder="Cantidad (+ para sumar, - para restar)" @bind="ajusteCantidad" />
        <button class="btn-primario mt-3 w-full" @onclick="AplicarAjusteAsync">Aplicar ajuste</button>
    }
</ModalShell>

@code {
    private List<ProductoDto> productos = [];
    private List<CategoriaProductoDto> categorias = [];
    private List<ProveedorDto> proveedores = [];
    private bool cargando = true;

    private bool modalVisible;
    private long? editandoId;
    private bool guardando;
    private string? error;
    private FormModel form = new();

    private bool modalStockVisible;
    private ProductoDto? productoAjuste;
    private int ajusteCantidad;

    private bool subiendoImagen;
    private string? errorImagen;
    private string? imagenPreviewUrl;

    private const long TamanoMaximoImagenBytes = 10 * 1024 * 1024;
    private static readonly HashSet<string> ContentTypesPermitidos = new(StringComparer.OrdinalIgnoreCase)
    {
        "image/jpeg", "image/jpg", "image/png", "image/webp", "image/gif",
    };

    protected override async Task OnInitializedAsync()
    {
        categorias = await CategoriasApiClient.GetAllAsync();
        proveedores = await ProveedoresApiClient.GetAllAsync();
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;
        productos = await ProductosApiClient.GetAllAsync();
        cargando = false;
    }

    private void AbrirCrear()
    {
        editandoId = null;
        form = new FormModel();
        error = null;
        imagenPreviewUrl = null;
        errorImagen = null;
        modalVisible = true;
    }

    private void AbrirEditar(ProductoDto producto)
    {
        editandoId = producto.Id;
        form = new FormModel
        {
            Nombre = producto.Nombre,
            Descripcion = producto.Descripcion,
            CategoriaId = producto.CategoriaId ?? 0,
            ProveedorId = producto.ProveedorId ?? 0,
            Precio = producto.Precio,
            ImagenUrl = producto.ImagenUrl,
            Activo = producto.Activo,
            Tipo = producto.Tipo,
        };
        error = null;
        imagenPreviewUrl = null;
        errorImagen = null;
        modalVisible = true;
    }

    private void AbrirAjusteStock(ProductoDto producto)
    {
        productoAjuste = producto;
        ajusteCantidad = 0;
        modalStockVisible = true;
    }

    private async Task AplicarAjusteAsync()
    {
        if (productoAjuste is null || ajusteCantidad == 0) return;

        var response = await ProductosApiClient.AjustarStockAsync(productoAjuste.Id, new AjustarStockRequest(ajusteCantidad));
        if (response.IsSuccessStatusCode)
        {
            modalStockVisible = false;
            await CargarAsync();
        }
    }

    private async Task SubirImagenAsync(InputFileChangeEventArgs e)
    {
        errorImagen = null;
        imagenPreviewUrl = null;
        var archivo = e.File;

        if (!ContentTypesPermitidos.Contains(archivo.ContentType))
        {
            errorImagen = "Formato no soportado. Usa una imagen JPEG, PNG, WEBP o GIF.";
            return;
        }

        if (archivo.Size > TamanoMaximoImagenBytes)
        {
            errorImagen = "El archivo supera el tamaño máximo permitido (10 MB).";
            return;
        }

        subiendoImagen = true;
        try
        {
            using var ms = new MemoryStream();
            await archivo.OpenReadStream(TamanoMaximoImagenBytes).CopyToAsync(ms);
            imagenPreviewUrl = $"data:{archivo.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
            ms.Position = 0;

            var (exito, url, error) = await ArchivosApiClient.SubirImagenAsync("productos", ms, archivo.Name, archivo.ContentType);
            if (exito)
            {
                form.ImagenUrl = url;
            }
            else
            {
                // Sin esto la vista previa quedaba con "Así se verá en la tienda" aunque la subida
                // fallara, y parecía que la imagen se había guardado.
                imagenPreviewUrl = null;
                errorImagen = error ?? "No se pudo subir la imagen.";
            }
        }
        finally
        {
            subiendoImagen = false;
        }
    }

    private async Task GuardarAsync()
    {
        error = null;
        guardando = true;
        try
        {
            HttpResponseMessage response;
            if (editandoId is null)
            {
                response = await ProductosApiClient.CrearAsync(new CrearProductoRequest(
                    form.Nombre, form.Descripcion,
                    form.CategoriaId > 0 ? form.CategoriaId : null,
                    form.Precio, form.Stock, form.ImagenUrl,
                    form.ProveedorId > 0 ? form.ProveedorId : null,
                    form.Tipo));
            }
            else
            {
                response = await ProductosApiClient.ActualizarAsync(editandoId.Value, new ActualizarProductoRequest(
                    form.Nombre, form.Descripcion,
                    form.CategoriaId > 0 ? form.CategoriaId : null,
                    form.Precio, form.ImagenUrl,
                    form.ProveedorId > 0 ? form.ProveedorId : null,
                    form.Activo,
                    form.Tipo));
            }

            if (!response.IsSuccessStatusCode)
            {
                error = await response.LeerMensajeAsync();
                return;
            }

            modalVisible = false;
            await CargarAsync();
        }
        finally
        {
            guardando = false;
        }
    }

    private class FormModel
    {
        public string Nombre { get; set; } = "";
        public string? Descripcion { get; set; }
        public long CategoriaId { get; set; }
        public long ProveedorId { get; set; }
        public decimal Precio { get; set; }
        public int Stock { get; set; }
        public string? ImagenUrl { get; set; }
        public bool Activo { get; set; } = true;
        public string Tipo { get; set; } = "venta_publico";
    }
}
