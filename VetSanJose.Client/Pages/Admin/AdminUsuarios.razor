@using System.Text.RegularExpressions
@using VetSanJose.Shared.Usuarios
@inject UsuariosApiClient UsuariosApiClient
@inject IJSRuntime JsRuntime

<div>
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <select class="campo-brutal-sm w-auto" @bind="filtroRol" @bind:after="CargarAsync">
            <option value="">Todos los roles</option>
            <option value="@Roles.Cliente">Cliente</option>
            <option value="@Roles.Doctor">Doctor</option>
            <option value="@Roles.Secretaria">Secretaria</option>
            <option value="@Roles.Administrador">Administrador</option>
        </select>
        <button class="btn-primario" @onclick="AbrirCrear">+ Nuevo usuario</button>
    </div>

    @if (!string.IsNullOrEmpty(errorTabla))
    {
        <p class="mb-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-[var(--color-error)]">@errorTabla</p>
    }

    @if (cargando)
    {
        <div class="skeleton h-40"></div>
    }
    else
    {
        <div class="tabla-scroll">
            <table class="w-full min-w-[44rem] text-left text-sm">
                <thead>
                    <tr class="border-b border-[var(--color-gris-borde)] text-gray-500">
                        <th class="py-2">Nombre</th>
                        <th class="py-2">Correo</th>
                        <th class="py-2">Rol</th>
                        <th class="py-2">Estado</th>
                        <th class="py-2"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in usuarios)
                    {
                        <tr class="border-b border-[var(--color-gris-borde)]">
                            <td class="py-2">@usuario.Nombre @usuario.Apellido</td>
                            <td class="py-2">@usuario.Email</td>
                            <td class="py-2">
                                <select class="campo-brutal-sm capitalize" value="@usuario.Rol"
                                        disabled="@(procesandoId == usuario.Id)"
                                        @onchange="e => CambiarRolAsync(usuario, e.Value?.ToString())">
                                    <option value="@Roles.Cliente">Cliente</option>
                                    <option value="@Roles.Doctor">Doctor</option>
                                    <option value="@Roles.Secretaria">Secretaria</option>
                                    <option value="@Roles.Administrador">Administrador</option>
                                </select>
                            </td>
                            <td class="py-2">
                                <span class="rounded-full px-2 py-0.5 text-xs @(usuario.Activo ? "bg-green-50 text-[var(--color-exito)]" : "bg-red-50 text-[var(--color-error)]")">
                                    @(usuario.Activo ? "Activo" : "Desactivado")
                                </span>
                            </td>
                            <td class="py-2 text-right">
                                <button class="inline-flex min-h-11 items-center text-[var(--color-celeste-intenso)] hover:underline" @onclick="() => AbrirEditar(usuario)">Editar</button>
                                <button class="ml-3 inline-flex min-h-11 items-center hover:underline @(usuario.Activo ? "text-[var(--color-error)]" : "text-[var(--color-exito)]")"
                                        disabled="@(procesandoId == usuario.Id)"
                                        @onclick="() => CambiarEstadoAsync(usuario)">
                                    @(usuario.Activo ? "Desactivar" : "Reactivar")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<ModalShell @bind-Visible="modalVisible" Titulo="@(editandoId is null ? "Nuevo usuario" : "Editar usuario")">
    @if (!string.IsNullOrEmpty(error))
    {
        <p class="mb-3 rounded-lg bg-red-50 px-3 py-2 text-sm text-[var(--color-error)]">@error</p>
    }
    <div class="space-y-3">
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <input class="campo-brutal" placeholder="Nombre" @bind="form.Nombre" @bind:event="oninput" pattern="[A-Za-zÁÉÍÓÚÑÜáéíóúñü\s'-]+" title="Solo letras" />
            <input class="campo-brutal" placeholder="Apellido" @bind="form.Apellido" @bind:event="oninput" pattern="[A-Za-zÁÉÍÓÚÑÜáéíóúñü\s'-]+" title="Solo letras" />
        </div>
        <input type="email" class="w-full campo-brutal" placeholder="Correo" @bind="form.Email" disabled="@(editandoId is not null)" />
        @if (editandoId is null)
        {
            <input type="password" class="w-full campo-brutal" placeholder="Contraseña temporal" @bind="form.Password" />
        }
        <input type="tel" class="w-full campo-brutal" placeholder="Teléfono (opcional)" @bind="form.Telefono" @bind:event="oninput" pattern="\+?[0-9]{7,15}" title="Solo números (7 a 15 dígitos), '+' opcional al inicio" />
        <select class="w-full campo-brutal" @bind="form.Rol">
            <option value="@Roles.Cliente">Cliente</option>
            <option value="@Roles.Doctor">Doctor</option>
            <option value="@Roles.Secretaria">Secretaria</option>
            <option value="@Roles.Administrador">Administrador</option>
        </select>

        @if (form.Rol == Roles.Doctor)
        {
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                <input class="campo-brutal" placeholder="Especialidad" @bind="form.Especialidad" />
                <input class="campo-brutal" placeholder="Matrícula" @bind="form.Matricula" @bind:event="oninput"
                       pattern="[0-9]+" title="Solo números" />
            </div>
        }

        @if (editandoId is not null)
        {
            <label class="flex items-center gap-2 text-sm">
                <input type="checkbox" @bind="form.Activo" /> Usuario activo
            </label>
        }

        <button class="btn-primario w-full" disabled="@guardando" @onclick="GuardarAsync">
            @(guardando ? "Guardando..." : "Guardar")
        </button>
    </div>
</ModalShell>

@code {
    private List<UsuarioAdminDto> usuarios = [];
    private string filtroRol = "";
    private bool cargando = true;

    private bool modalVisible;
    private long? editandoId;
    private long? procesandoId;
    private string? errorTabla;
    private bool guardando;
    private string? error;
    private FormModel form = new();

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        cargando = true;
        usuarios = await UsuariosApiClient.GetAllAsync(string.IsNullOrWhiteSpace(filtroRol) ? null : filtroRol);
        cargando = false;
    }

    private async Task CambiarEstadoAsync(UsuarioAdminDto usuario)
    {
        errorTabla = null;

        var accion = usuario.Activo ? "desactivar" : "reactivar";
        var confirmado = await JsRuntime.InvokeAsync<bool>(
            "confirm",
            usuario.Activo
                ? $"¿Desactivar a {usuario.Nombre} {usuario.Apellido}? No podrá iniciar sesión ni aparecerá en los selectores, pero se conserva su historial."
                : $"¿Reactivar a {usuario.Nombre} {usuario.Apellido}?");
        if (!confirmado) return;

        procesandoId = usuario.Id;
        try
        {
            var response = await UsuariosApiClient.CambiarEstadoAsync(usuario.Id, !usuario.Activo);
            if (!response.IsSuccessStatusCode)
            {
                errorTabla = await response.LeerMensajeAsync();
                return;
            }

            await CargarAsync();
        }
        catch (HttpRequestException ex)
        {
            errorTabla = $"No se pudo {accion} el usuario: {ex.Message}";
        }
        finally
        {
            procesandoId = null;
        }
    }

    private async Task CambiarRolAsync(UsuarioAdminDto usuario, string? nuevoRol)
    {
        errorTabla = null;

        if (string.IsNullOrWhiteSpace(nuevoRol) || nuevoRol == usuario.Rol) return;

        var confirmado = await JsRuntime.InvokeAsync<bool>(
            "confirm", $"¿Cambiar el rol de {usuario.Nombre} {usuario.Apellido} a \"{nuevoRol}\"? Se aplicará en su próximo inicio de sesión.");
        if (!confirmado)
        {
            await CargarAsync();
            return;
        }

        procesandoId = usuario.Id;
        try
        {
            var response = await UsuariosApiClient.CambiarRolAsync(usuario.Id, nuevoRol);
            if (!response.IsSuccessStatusCode)
            {
                errorTabla = await response.LeerMensajeAsync();
            }

            await CargarAsync();
        }
        catch (HttpRequestException ex)
        {
            errorTabla = $"No se pudo cambiar el rol: {ex.Message}";
            await CargarAsync();
        }
        finally
        {
            procesandoId = null;
        }
    }

    private void AbrirCrear()
    {
        editandoId = null;
        form = new FormModel { Rol = Roles.Cliente };
        error = null;
        modalVisible = true;
    }

    private void AbrirEditar(UsuarioAdminDto usuario)
    {
        editandoId = usuario.Id;
        form = new FormModel
        {
            Nombre = usuario.Nombre,
            Apellido = usuario.Apellido,
            Email = usuario.Email,
            Telefono = usuario.Telefono,
            Rol = usuario.Rol,
            Activo = usuario.Activo,
            Especialidad = usuario.Especialidad,
            Matricula = usuario.Matricula,
        };
        error = null;
        modalVisible = true;
    }

    private static readonly Regex NombreRegex = new(@"^[A-Za-zÁÉÍÓÚÑÜáéíóúñü\s'-]+$", RegexOptions.Compiled);
    private static readonly Regex TelefonoRegex = new(@"^\+?[0-9]{7,15}$", RegexOptions.Compiled);
    private static readonly Regex MatriculaRegex = new(@"^[0-9]{1,20}$", RegexOptions.Compiled);

    private async Task GuardarAsync()
    {
        error = null;

        if (!NombreRegex.IsMatch(form.Nombre.Trim()))
        {
            error = "El nombre solo puede contener letras.";
            return;
        }

        if (!NombreRegex.IsMatch(form.Apellido.Trim()))
        {
            error = "El apellido solo puede contener letras.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(form.Telefono) && !TelefonoRegex.IsMatch(form.Telefono.Trim()))
        {
            error = "El teléfono solo puede contener números (7 a 15 dígitos), con un '+' opcional al inicio.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(form.Matricula) && !MatriculaRegex.IsMatch(form.Matricula.Trim()))
        {
            error = "La matrícula solo puede contener números.";
            return;
        }

        guardando = true;
        try
        {
            HttpResponseMessage response;
            if (editandoId is null)
            {
                response = await UsuariosApiClient.CrearAsync(new CrearUsuarioRequest(
                    form.Nombre, form.Apellido, form.Email, form.Password, form.Rol, form.Telefono,
                    form.Especialidad, form.Matricula));
            }
            else
            {
                response = await UsuariosApiClient.ActualizarAsync(editandoId.Value, new ActualizarUsuarioRequest(
                    form.Nombre, form.Apellido, form.Rol, form.Telefono, form.Activo,
                    form.Especialidad, form.Matricula));
            }

            if (!response.IsSuccessStatusCode)
            {
                error = await response.LeerMensajeAsync();
                return;
            }

            modalVisible = false;
            await CargarAsync();
        }
        finally
        {
            guardando = false;
        }
    }

    private class FormModel
    {
        public string Nombre { get; set; } = "";
        public string Apellido { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string? Telefono { get; set; }
        public string Rol { get; set; } = Roles.Cliente;
        public bool Activo { get; set; } = true;
        public string? Especialidad { get; set; }
        public string? Matricula { get; set; }
    }
}
