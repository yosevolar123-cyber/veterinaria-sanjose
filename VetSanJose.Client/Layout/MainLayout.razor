@inherits LayoutComponentBase

<div class="flex min-h-screen flex-col bg-white">
    <Navbar />

    <main class="flex-1">
        @Body
    </main>

    <footer class="bg-[var(--color-celeste-intenso)] text-white">
        <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:grid-cols-2 sm:px-6 lg:grid-cols-4">
            <div>
                <div class="mb-3 flex items-center gap-2">
                    <svg viewBox="0 0 48 48" class="h-8 w-8" fill="currentColor" aria-hidden="true">
                        <ellipse cx="24" cy="30" rx="12" ry="10" />
                        <ellipse cx="9" cy="16" rx="5" ry="6.5" />
                        <ellipse cx="20" cy="9" rx="5" ry="6.5" />
                        <ellipse cx="28" cy="9" rx="5" ry="6.5" />
                        <ellipse cx="39" cy="16" rx="5" ry="6.5" />
                    </svg>
                    <span class="font-titulos text-lg font-bold">Veterinaria San José</span>
                </div>
                <p class="text-sm text-white/80">Av. Principal 123, Zona Central, Santa Cruz, Bolivia</p>
            </div>

            <div>
                <h4 class="mb-3 font-titulos font-semibold">Enlaces</h4>
                <ul class="space-y-2 text-sm text-white/80">
                    <li><a href="/" class="hover:text-white">Inicio</a></li>
                    <li><a href="/tienda" class="hover:text-white">Tienda</a></li>
                    <li><a href="/contacto" class="hover:text-white">Contacto</a></li>
                </ul>
            </div>

            <div>
                <h4 class="mb-3 font-titulos font-semibold">Horario de atención</h4>
                <ul class="space-y-1 text-sm text-white/80">
                    <li>Lunes a viernes: 8:00 - 19:00</li>
                    <li>Sábados: 9:00 - 14:00</li>
                    <li>Domingos: cerrado</li>
                </ul>
            </div>

            <div>
                <h4 class="mb-3 font-titulos font-semibold">Síguenos</h4>
                <div class="flex gap-3">
                    <a href="#" aria-label="Facebook" class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 transition hover:bg-white/20">
                        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M13.5 21v-7h2.3l.35-2.7h-2.65V9.5c0-.8.2-1.35 1.4-1.35h1.5V5.75c-.25-.03-1.1-.1-2.1-.1-2.1 0-3.5 1.28-3.5 3.63V11.3H8.5V14h2.35v7h2.65z" /></svg>
                    </a>
                    <a href="#" aria-label="Instagram" class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 transition hover:bg-white/20">
                        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="4" width="16" height="16" rx="4" /><circle cx="12" cy="12" r="3.2" /><circle cx="16.5" cy="7.5" r="0.6" fill="currentColor" /></svg>
                    </a>
                    <a href="#" aria-label="WhatsApp" class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 transition hover:bg-white/20">
                        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 20zm4.4-5.9c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1-.2.2-.6.8-.8 1-.1.2-.3.2-.5.1-.2-.1-1-.4-1.9-1.2-.7-.6-1.2-1.4-1.3-1.6-.1-.2 0-.4.1-.5l.4-.4c.1-.1.2-.2.2-.4 0-.1 0-.3 0-.4-.1-.1-.5-1.3-.7-1.8-.2-.4-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 1.9s.8 2.2.9 2.4c.1.2 1.6 2.5 4 3.5.6.2 1 .4 1.3.5.6.2 1 .1 1.4-.1.4-.2 1.4-.6 1.6-1.1.2-.5.2-.9.1-1z" /></svg>
                    </a>
                </div>
            </div>
        </div>

        <div class="border-t border-white/10 py-4 text-center text-xs text-white/60">
            © @DateTime.Now.Year Veterinaria San José — Cuidamos a tu mejor amigo como parte de la familia 🐾
        </div>
    </footer>
</div>
