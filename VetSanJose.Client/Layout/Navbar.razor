@inject TokenStorage TokenStorage
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<header class="sticky top-0 z-40 border-b border-transparent bg-white/80 backdrop-blur-md transition-colors">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
        <a href="/" class="flex items-center gap-2">
            <svg viewBox="0 0 48 48" class="logo-animada h-9 w-9 text-[var(--color-celeste-intenso)]" fill="currentColor" aria-hidden="true">
                <ellipse cx="24" cy="30" rx="12" ry="10" />
                <ellipse cx="9" cy="16" rx="5" ry="6.5" />
                <ellipse cx="20" cy="9" rx="5" ry="6.5" />
                <ellipse cx="28" cy="9" rx="5" ry="6.5" />
                <ellipse cx="39" cy="16" rx="5" ry="6.5" />
            </svg>
            <span class="font-titulos text-lg font-bold text-slate-800">Veterinaria San José</span>
        </a>

        <div class="hidden items-center gap-8 text-sm font-medium text-gray-600 sm:flex">
            <a href="/" class="transition-colors hover:text-[var(--color-celeste-intenso)]">Inicio</a>
            <a href="/tienda" class="transition-colors hover:text-[var(--color-celeste-intenso)]">Tienda</a>
            <a href="/contacto" class="transition-colors hover:text-[var(--color-celeste-intenso)]">Contacto</a>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="relative">
                    <button class="flex items-center gap-2 rounded-full border border-[var(--color-gris-borde)] bg-white py-1.5 pl-1.5 pr-3 text-sm shadow-sm transition hover:shadow-md"
                            @onclick="() => menuAbierto = !menuAbierto">
                        <span class="flex h-7 w-7 items-center justify-center rounded-full bg-[var(--color-celeste-suave)] text-[var(--color-celeste-intenso)]">
                            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><circle cx="12" cy="8" r="4" /><path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8" /></svg>
                        </span>
                        <span class="hidden sm:inline">Mi cuenta</span>
                    </button>

                    @if (menuAbierto)
                    {
                        <div class="absolute right-0 mt-2 w-44 tarjeta py-2 text-sm shadow-lg" @onclick="() => menuAbierto = false">
                            <a href="@RutaPanel(context)" class="block px-4 py-2 hover:bg-[var(--color-celeste-suave)]">Mi panel</a>
                            <button class="block w-full px-4 py-2 text-left text-[var(--color-error)] hover:bg-red-50" @onclick="CerrarSesionAsync">
                                Cerrar sesión
                            </button>
                        </div>
                    }
                </div>
            </Authorized>
            <NotAuthorized>
                <button title="Iniciar sesión" aria-label="Iniciar sesión"
                        class="flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-celeste-suave)] text-[var(--color-celeste-intenso)] shadow-sm transition hover:bg-[var(--color-celeste)] hover:text-white hover:shadow-md active:scale-95"
                        @onclick="AbrirLogin">
                    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="5" y="11" width="14" height="9" rx="2" />
                        <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                    </svg>
                </button>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</header>

<LoginModal @bind-Visible="loginVisible" />

@code {
    private bool menuAbierto;
    private bool loginVisible;

    [Parameter] public EventCallback OnLoginRequested { get; set; }

    public void AbrirLogin() => loginVisible = true;

    private static string RutaPanel(AuthenticationState context)
    {
        var rol = context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        return rol switch
        {
            Roles.Doctor => "/panel-doctor",
            Roles.Secretaria => "/panel-secretaria",
            Roles.Administrador => "/panel-admin",
            _ => "/mi-cuenta",
        };
    }

    private async Task CerrarSesionAsync()
    {
        await TokenStorage.LimpiarAsync();
        AuthStateProvider.NotificarSesionCerrada();
        menuAbierto = false;
        Navigation.NavigateTo("/");
    }
}
